{
    "name": "node-assets-cli",
    "private": true,
    "version": "0.1.0",
    "description": "Make 3D models small and web-ready with reusable processing graphs.",
    "license": "Apache-2.0",
    "type": "module",
    "sideEffects": false,
    "bin": {
        "node-assets": "./bin/node-assets.cjs"
    },
    "files": [
        "bin",
        "dist",
        "graphs"
    ],
    "repository": {
        "type": "git",
        "url": "git+https://github.com/BabylonJS/Node-Assets.git",
        "directory": "packages/cli"
    },
    "bugs": {
        "url": "https://github.com/BabylonJS/Node-Assets/issues"
    },
    "engines": {
        "node": "^20.19.0 || ^22.13.0 || >=24"
    },
    "scripts": {
        "build": "vite build && vite build --config vite.render.config.ts",
        "calibrate:build": "vite build --config vite.calibrate.config.ts"
    },
    "dependencies": {
        "@babylonjs/core": "^9.27.1",
        "@babylonjs/ktx2decoder": "9.27.1",
        "@babylonjs/loaders": "^9.27.1",
        "@babylonjs/serializers": "^9.27.1",
        "@gltf-transform/core": "4.5.0",
        "@gltf-transform/extensions": "4.5.0",
        "@gltf-transform/functions": "4.5.0",
        "@toon-format/toon": "4.4.0",
        "@types/draco3dgltf": "1.4.3",
        "babylonpress-ktx2-encoder": "0.6.0",
        "draco3dgltf": "1.5.7",
        "gltf-validator": "2.0.0-dev.3.10",
        "meshoptimizer": "1.2.0",
        "playwright-core": "1.64.1",
        "sharp": "0.35.5",
        "xhr2": "0.2.1"
    }
}
